  "Change the password for a local administrator account.\n\nIf no local administrator has been configured yet, this\noption lets you set up an initial admin or root account.\n\nNote: changing a password will disable two-factor\nauthentication for that account.": {
    "machine_translated": true,
    "translation": "Localирле администратор счеты өчен серсүзне үзгәртегез.\n\nӘгәр дә җирле администратор конфигурацияләнмәгән булса, бу\nвариант сезгә башлангыч администратор яки тамыр счетын урнаштырырга мөмкинлек бирә.\n\nИскәрмә: серсүзне үзгәртү ике факторны сүндерәчәк\nбу хисап өчен аутентификация."
  },
  "Changes applied. Network will roll back in ~60 seconds\nunless you press [p] to persist them.": {
    "machine_translated": true,
    "translation": "Changзгәрешләр кулланылды. Челтәр ~ 60 секунд эчендә кире кайтачак\nдәвам итәр өчен [р] басыгыз."
  },
  "Changes applied. Press [p] to persist or they roll back in {n}s.": {
    "machine_translated": true,
    "translation": "Changзгәрешләр кулланылды. Туктау өчен [р] басыгыз, яисә алар кире әйләнеп кайталар."
  },
  "Configuration reset cancelled.": {
    "machine_translated": true,
    "translation": "Конфигурацияне яңадан торгызу юкка чыгарылды."
