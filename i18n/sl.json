  "Change the password for a local administrator account.\n\nIf no local administrator has been configured yet, this\noption lets you set up an initial admin or root account.\n\nNote: changing a password will disable two-factor\nauthentication for that account.": {
    "machine_translated": true,
    "translation": "Spremenite geslo za lokalni skrbniški račun.\n\nČe lokalni skrbnik še ni bil konfiguriran, to\nomogoča nastavitev začetnega skrbniškega ali korenskega računa.\n\nOpomba: sprememba gesla bo onemogočila dvofaktorje\navtentikacijo za ta račun."
  },
  "Changes applied. Network will roll back in ~60 seconds\nunless you press [p] to persist them.": {
    "machine_translated": true,
    "translation": "Uporabljene spremembe. Omrežje se bo vrnilo v približno 60 sekundah\nrazen če pritisnete [p], da jih obdržite."
  },
  "Changes applied. Press [p] to persist or they roll back in {n}s.": {
    "machine_translated": true,
    "translation": "Uporabljene spremembe. Pritisnite [p], da vztrajate ali pa se vrnejo nazaj v {n} s."
  },
