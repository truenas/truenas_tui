  "Change the password for a local administrator account.\n\nIf no local administrator has been configured yet, this\noption lets you set up an initial admin or root account.\n\nNote: changing a password will disable two-factor\nauthentication for that account.": {
    "machine_translated": true,
    "translation": "Pakeiskite vietinio administratoriaus paskyros slaptažodį.\n\nJei dar nebuvo sukonfigūruotas vietinis administratorius, tai\nparinktis leidžia nustatyti pradinę administratoriaus arba šakninę paskyrą.\n\nPastaba: pakeitus slaptažodį bus išjungtas dviejų faktorių režimas\ntos paskyros autentifikavimas."
  },
  "Changes applied. Network will roll back in ~60 seconds\nunless you press [p] to persist them.": {
    "machine_translated": true,
    "translation": "Pakeitimai pritaikyti. Tinklas atsigaus po ~60 sekundžių\nnebent paspausite [p], kad juos išlaikytumėte."
  },
  "Changes applied. Press [p] to persist or they roll back in {n}s.": {
    "machine_translated": true,
    "translation": "Pakeitimai pritaikyti. Paspauskite [p], kad išliktų, arba jie grįš po {n} sek."
